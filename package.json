{
  "name": "atb-collections",
  "version": "0.1.0",
  "private": true,
  "description": "ATB Collections - internal collections operating layer for unsecured AZN consumer cash loans (synthetic demo build)",
  "type": "module",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "worker": "tsx src/worker/main.ts",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "test": "vitest run --project unit",
    "test:integration": "vitest run --project integration",
    "test:all": "vitest run",
    "e2e": "node e2e/run.mjs",
    "db:generate": "prisma generate",
    "db:migrate": "prisma migrate deploy",
    "db:migrate:dev": "prisma migrate dev",
    "db:reset": "tsx scripts/db-reset.ts",
    "db:seed": "tsx prisma/seed.ts",
    "pilot:users": "tsx scripts/create-pilot-users.ts",
    "db:studio": "prisma studio",
    "screenshots": "node e2e/screenshots.mjs",
    "measure": "node e2e/measure.mjs",
    "screenshots:agent": "node e2e/agent-states.mjs"
  },
  "dependencies": {
    "@prisma/adapter-pg": "7.10.1",
    "@prisma/client": "7.10.1",
    "@tanstack/react-table": "^9.3.1",
    "decimal.js": "10.6.0",
    "luxon": "3.7.2",
    "next": "16.4.3",
    "pg": "8.23.1",
    "pg-boss": "12.38.0",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "4.3.3",
    "@types/luxon": "^3.7.1",
    "@types/node": "^22.19.0",
    "@types/pg": "^8.15.0",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "dotenv": "^17.2.0",
    "eslint": "10.13.0",
    "eslint-config-next": "16.4.3",
    "prisma": "7.10.1",
    "tailwindcss": "4.3.3",
    "tsx": "4.23.15",
    "typescript": "5.9.3",
    "vitest": "5.0.5"
  }
}
