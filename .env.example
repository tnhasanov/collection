# ATB Collections - local demo environment template (no secrets)
# Copy to .env and adjust for your machine. Never commit real credentials.

# PostgreSQL connection used by the web app, worker, migrations and seed.
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/atb_collections?schema=public"
# Separate database for integration tests (tests reset it).
TEST_DATABASE_URL="postgresql://postgres:postgres@localhost:5432/atb_collections_test?schema=public"

# DEMO enables local demo identities, role switching and the payment simulator.
# INTEGRATION disables all of them and requires the real adapters to be configured and approved.
APP_MODE="DEMO"

# Demo clock: "offset" anchors the seeded business date (27 Oct 2026, Asia/Baku) to the moment of seeding
# and lets time advance from there; "real" uses the host clock (INTEGRATION mode always uses real time).
DEMO_CLOCK_MODE="offset"

# Session cookie signing secret for the local demo identity provider. Replace in any non-local setup.
SESSION_SECRET="change-me-local-demo-only"

# pg-boss schema used by the durable worker.
PGBOSS_SCHEMA="pgboss"

# Real connector feature flags: all default off. Turning one on requires its adapter configuration and bank approval.
CONNECTOR_CORE_BANKING="mock"
CONNECTOR_PAYMENT_FEED="mock"
CONNECTOR_SMS="mock"
CONNECTOR_DIALER="mock"
CONNECTOR_IDENTITY="local-demo"

# Base URL used by the e2e browser flow.
APP_URL="http://localhost:3000"
